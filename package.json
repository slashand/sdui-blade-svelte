{
	"name": "@slashand/sdui-blade-svelte",
	"version": "1.0.2-alpha.1",
	"description": "Svelte Implementation Shell for the SDUI Blade Architecture.",
	"author": "Slashand LLC",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/slashand/sdui-blade-svelte.git"
	},
	"bugs": {
		"url": "https://github.com/slashand/sdui-blade-svelte/issues"
	},
	"homepage": "https://github.com/slashand/sdui-blade-svelte#readme",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"publish:alpha": "npm version prerelease --preid=alpha --no-git-tag-version && npm run build && npm publish --tag alpha",
		"publish:prod": "npm version patch --no-git-tag-version && npm run build && npm publish"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "2.0.5",
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.58.0",
		"@sveltejs/package": "2.5.7",
		"@sveltejs/vite-plugin-svelte": "7.0.0",
		"@tailwindcss/vite": "4.2.4",
		"@types/node": "25.6.0",
		"eslint": "10.2.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.17.1",
		"globals": "17.5.0",
		"prettier": "3.8.3",
		"prettier-plugin-svelte": "3.5.1",
		"publint": "^0.3.18",
		"svelte": "5.55.5",
		"svelte-check": "4.4.6",
		"tailwindcss": "4.2.4",
		"typescript": "5.5.4",
		"typescript-eslint": "8.59.0",
		"vite": "8.0.10"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@slashand/sdui-blade-core": "1.0.0-alpha.4",
		"clsx": "^2.1.1",
		"lucide-svelte": "^1.0.1",
		"tailwind-merge": "^3.5.0"
	}
}