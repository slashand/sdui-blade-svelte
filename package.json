{
	"name": "@slashand/sdui-blade-svelte",
	"version": "1.1.0",
	"description": "Svelte Implementation Shell for the SDUI Blade Architecture.",
	"author": "Slashand LLC",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/slashand/sdui-blade-svelte.git"
	},
	"bugs": {
		"url": "https://github.com/slashand/sdui-blade-svelte/issues"
	},
	"homepage": "https://github.com/slashand/sdui-blade-svelte#readme",
	"publishConfig": {
		"access": "public",
		"tag": "latest"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:browser": "playwright test --config tests/playwright.config.ts",
		"test:gallery": "playwright test --config tests/gallery.config.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"publish:latest": "npm run build && npm publish --tag latest",
		"publish:prod": "npm run publish:latest"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./sdui-blade-svelte.css": {
			"default": "./dist/sdui-blade-svelte.css"
		}
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-static": "3.0.11",
		"@sveltejs/kit": "2.70.4",
		"@sveltejs/package": "2.5.8",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "24.19.2",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "3.5.2",
		"publint": "^0.3.25",
		"svelte": "5.58.0",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"typescript": "5.9.3",
		"typescript-eslint": "8.73.0",
		"vite": "8.3.8"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@slashand/sdui-blade-core": "1.1.0",
		"clsx": "^2.1.1",
		"lucide-svelte": "^1.0.1",
		"tailwind-merge": "^3.7.0"
	}
}
